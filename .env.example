# Application
APP_NAME=GhanaGoetheBooking
ENVIRONMENT=production
DEBUG=False
SECRET_KEY=your-super-secret-key-change-this
API_V1_PREFIX=/api/v1

# Database
POSTGRES_HOST=postgres
POSTGRES_PORT=5432
POSTGRES_USER=booking_user
POSTGRES_PASSWORD=strong_password
POSTGRES_DB=ghana_goethe_booking
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@${POSTGRES_HOST}:${POSTGRES_PORT}/${POSTGRES_DB}

# Redis
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD=
REDIS_DB=0
REDIS_URL=redis://${REDIS_HOST}:${REDIS_PORT}/${REDIS_DB}

# Admin
ADMIN_EMAIL=admin@ghana-goethe.com
ADMIN_PASSWORD_HASH=bcrypt_hash_here
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=7

# Proxy
PROXY_ENABLED=True
PROXY_LIST_URL=https://api.proxy-service.com/get
PROXY_ROTATION_STRATEGY=round_robin
PROXY_HEALTH_CHECK_INTERVAL=300

# Playwright
PLAYWRIGHT_HEADLESS=True
PLAYWRIGHT_TIMEOUT=30000
BROWSER_MAX_CONCURRENT=5
BROWSER_CONTEXTS_PER_SESSION=3

# Retry
RETRY_MAX_ATTEMPTS=5
RETRY_BACKOFF_FACTOR=2
RETRY_MAX_DELAY=60

# Telegram
TELEGRAM_BOT_TOKEN=your_bot_token
TELEGRAM_CHAT_ID=your_chat_id
NOTIFICATIONS_ENABLED=True

# Task Queue
TASK_QUEUE_MAX_WORKERS=10
TASK_QUEUE_POLL_INTERVAL=1

# Monitoring
LOG_LEVEL=INFO
SENTRY_DSN=your_sentry_dsn